# ===== Alma AI — настройки сервера =====
# Скопируйте в .env и заполните. Файл .env никогда не коммитьте.

# Домен без "app." — лендинг будет на https://DOMAIN, кабинет на https://app.DOMAIN
DOMAIN=example.kz
# Почта для уведомлений Let's Encrypt (сертификаты HTTPS)
ACME_EMAIL=

# Секрет шифрования сессий WhatsApp и кодов. Обязателен в продакшене.
# Сгенерируйте: openssl rand -hex 32   (не меняйте после запуска — сессии WhatsApp станут нечитаемыми)
APP_SECRET=

# ----- Администратор -----
# Отдельной страницы входа в админку нет: вы входите через обычный /login
# своим номером ADMIN_PHONE и паролем, затем подтверждаете вход кодом.
# Номер администратора (формат 77001234567). Сюда же приходит код входа в WhatsApp.
ADMIN_PHONE=
# Хеш пароля администратора (Argon2id): docker compose run --rm app node src/cli.ts hash-password
# Пароль в открытом виде в .env не храните.
ADMIN_PASSWORD_HASH=
# Номер, на который клиенты пишут, чтобы продлить доступ к AI (кнопка «Написать нам»)
SUPPORT_WHATSAPP=
# Бесплатные дни AI для новых регистраций (0 — доступ только после того, как вы его откроете)
AI_TRIAL_DAYS=0

# OpenAI
OPENAI_API_KEY=
# Модель для режима «Оптимальная» и «Максимум качества» в настройках агента
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_QUALITY=gpt-5.4
# none | minimal | low | medium | high — пусто = значение модели по умолчанию
OPENAI_REASONING_EFFORT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Расшифровка голосовых сообщений
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# ----- Медиа и история -----
# Максимальный размер фото/видео/документа для сохранения в чате, МБ
MEDIA_MAX_MB=25
# Сколько дней хранить файлы на сервере
MEDIA_RETENTION_DAYS=180
# За сколько дней импортировать историю переписки при подключении WhatsApp
# (0 — всю историю, которую отдаст телефон)
HISTORY_DAYS=0

LOG_LEVEL=info

# ----- Только для локальной разработки -----
# Печатать коды подтверждения в лог сервера, пока номер-отправитель не подключён
# (в продакшене игнорируется)
# OTP_DEV_LOG=true
